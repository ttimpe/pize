{
    "compilerOptions": {
      "module": "NodeNext",
      "esModuleInterop": true,
      "moduleResolution": "NodeNext",
      "sourceMap": true,
      "outDir": "dist",
      "experimentalDecorators": true,
      "useDefineForClassFields": false,
  },
    "include": [
      "src/**/*"
    ],
    "scripts": {
      "build": "tsc --build",
      "clean": "tsc --build --clean"
    },

    "lib": ["es2021"]
  }