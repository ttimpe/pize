{
  "name": "ibisplusplus",
  "version": "1.0.0",
  "description": "PIZE - Reimplementation einer IBIS-Zentraleinheit (IZE) fuer Busse und Stadtbahnen",
  "main": "dist/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently -k \"socat -d -d pty,raw,echo=0,link=./ttyV0 pty,raw,echo=0,link=./ttyV1\" \"sleep 1 && tsx watch src ./ttyV0\"",
    "start": "node dist/index.js",
    "build": "tsc",
    "postinstall": "patch-package"
  },
  "keywords": [
    "ibis",
    "vdv",
    "vdv452",
    "oepnv",
    "public-transport",
    "raspberry-pi"
  ],
  "author": "Tobias Timpe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttimpe/pize.git"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/onoff": "^3.2.1",
    "@types/play-sound": "^1.1.2",
    "@types/sequelize": "^4.28.20",
    "@types/sqlite3": "^3.1.11",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.2.1",
    "tsx": "^4.7.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "crc": "^4.3.2",
    "csv-parser": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "express": "^4.17.1",
    "fft.js": "^4.0.4",
    "node-microphone": "^0.1.6",
    "node-segfault-handler": "^1.4.2",
    "onoff": "^6.0.3",
    "patch-package": "^8.0.0",
    "play-sound": "^1.1.6",
    "raspi": "^6.0.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "serialport": "^12.0.0",
    "speaker": "^0.5.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "websocket": "^1.0.35",
    "ws": "^8.18.0"
  }
}